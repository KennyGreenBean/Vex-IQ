#pragma config(Sensor, port2,  RFColour,       sensorVexIQ_ColorGrayscale)
#pragma config(Sensor, port3,  BRColour,       sensorVexIQ_ColorGrayscale)
#pragma config(Sensor, port4,  Gyro,           sensorVexIQ_Gyro)
#pragma config(Sensor, port8,  LFColour,       sensorVexIQ_ColorGrayscale)
#pragma config(Sensor, port9,  BLColour,       sensorVexIQ_ColorGrayscale)
#pragma config(Motor,  motor1,          LMotor,        tmotorVexIQ, PIDControl, reversed, driveLeft, encoder)
#pragma config(Motor,  motor7,          RMotor,        tmotorVexIQ, PIDControl, driveRight, encoder)
//*!!Code automatically generated by 'ROBOTC' configuration wizard               !!*//

float output;
float error;
float motorSpeed;
float Right;
float Left;
int kp;
int distance;
int motorDegrees;

void GoStraight (float motorSpeed, int distance, int kp){
	resetGyro(Gyro);
	resetMotorEncoder(motor1);
	motorDegrees = distance / 20 * 360 / 2;
	repeatUntil(getMotorEncoder(motor1) >= motorDegrees){
	Right = Left = motorSpeed;
	setMotor(motor1, motorSpeed);
	setMotor(motor7, motorSpeed);
		repeat(10){
		setMotor(motor1, Left);
		setMotor(motor7, Right);
		wait1Msec(20);
		error = 0 + getGyroHeading(Gyro);
		wait1Msec(20);
		output = error * kp;
		wait1Msec(20);
		Left = motorSpeed + output;
		wait1Msec(10);
		Right = motorSpeed - output + 6;
		}
	}
	stopAllMotors();

}

task main()
{
	GoStraight(70, 200, 1);

}
