float integral = 0.0;
float previousError = 0.0;

float PIDController(float error, float kp, float ki, float kd, float dt)
{
    integral = integral + error * dt;
    float derivative = (error - previousError) / dt;
    float output = kp * error + ki * integral + kd * derivative;
    previousError = error;
    return output;
}

void goStraightPID(float heading, float speed, float distance, float kp, float ki, float kd)
{
	float error;
	float output;
	float dt = 20;
	integral = 0.0;
	previousError = 0.0;

	// reset all motor encoders
	resetChassisEncoder();
	resetGyro(Gyro);
	while (getChassisEncoder() < distance)
	{
		// P control of the robot direction
		error = heading - getGyroDegreesFloat(Gyro);
		output = PIDController(error, kp, ki, kd, dt);

		moveSteering(output, speed);

		wait1Msec(dt);
	}
	setChassisSpeed(0,0);
}

