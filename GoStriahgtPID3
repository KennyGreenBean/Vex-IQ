/**
* @brief Turn the robot to target rotation
*
* @param heading Target rotation of the robot turning
* @param steering Steering value to be passed to moveSteering (see moveSteering for detailed explanation)
* @param speed Moving speed of the robot
* @param momentum Momentum value to stop the robot before it reaches target rotation
*/
void turn(float heading, int steering, int speed, float momentum)
{
	int momentum2;
	momentum2 = momentum * (-1);
	resetGyro(Gyro);
	if(getGyroDegreesFloat(Gyro) > heading){ // turn right
		moveSteering(steering, speed);
		waitUntil(getGyroDegrees(Gyro) <= heading);
		setChassisSpeed(0, 0);
		setChassisSpeed(momentum2, momentum);
		waitUntil(getGyroDegreesFloat(Gyro) >=heading);
		setChassisSpeed(0, 0);
	}
	if(getGyroDegreesFloat(Gyro) < heading){ // turn left
		moveSteering(steering, speed);
		waitUntil(getGyroDegrees(Gyro) > heading);
			setChassisSpeed(0, 0);
			setChassisSpeed(momentum, momentum2);
			waitUntil(getGyroDegreesFloat(Gyro) <=heading);
			setChassisSpeed(0, 0);
		}

	}
	//_____________________________________________________________________________________________________________________
	float integral = 0.0;
	float previousError = 0.0;

	float PIDController(float error, float kp, float ki, float kd, float dt)
	{
		integral = integral + error * dt;
		float derivative = (error - previousError) / dt;
		float output = kp * error + ki * integral + kd * derivative;
		previousError = error;
		return output;
	}

	void goStraightPID(float heading, float speed, float distance, float kp, float ki, float kd, float accelRate, float decelRate, float minSpeed, bool stallDection = true)
	{
		float error;
		float output;
		float dt = 20;
		float decelZone = distance * 0.9;
		integral = 0.0;
		previousError = 0.0;
		float currentSpeed = minSpeed;
		int direction = sgn(speed);

		int currentEncoder = 0;
		int lastEncoder = 0;
		long startingTime = nSysTime;

		// reset all motor encoders
		resetChassisEncoder();
		resetGyro(Gyro);
		while (abs(getChassisEncoder()) < abs(distance))
		{
			// P control of the robot direction
			error = heading - getGyroDegreesFloat(Gyro);
			output = PIDController(error, kp, ki, kd, dt);

			if(abs(getChassisEncoder()) > (abs(distance) - abs(decelZone))){ //decel
				currentSpeed = currentSpeed * (1 - decelRate);

				if(abs(currentSpeed) < abs(minSpeed)){
					currentSpeed = abs(minSpeed) * direction;
			}
		}
		else if(abs(currentSpeed) < abs(speed)){ //accel
			currentSpeed = currentSpeed * (1 + accelRate);

			if(abs(currentSpeed) > abs(speed)){
				currentSpeed = speed;
		}
	}
	else //else
		currentSpeed = speed;

			moveSteering(output, speed);

			currentEncoder = getChassisEncoder();
			//if(stallDection && (abs(currentEncoder - lastEncoder)) <2){
				//playSound(soundSiren2);
				//break;
		}
		lastEncoder = currentEncoder;

			wait1Msec(dt);

			setChassisSpeed(0,0);
	//	}
	}

	/*
