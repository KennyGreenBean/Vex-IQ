{
	setMotorSpeed(LMotor, leftSpeed);
	setMotorSpeed(RMotor, rightSpeed);
}

float getChassisEncoder()
{
	return ((getMotorEncoder(LMotor)) + (getMotorEncoder(RMotor)/2));
}
